{
  "version": 2,
  "builds": [
    { "src": "api/notion.js", "use": "@vercel/node" },
    { "src": "api/sign.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/notion", "dest": "/api/notion.js" },
    { "src": "/api/sign", "dest": "/api/sign.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
